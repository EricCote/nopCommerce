@model Ecomzen.Plugin.Misc.Gifts.Models.GiftsWidgetModel
<text>
<style>
        :root {
            --bg-card: #ffffff;
            --border-color: #e5e7eb; /* gray-200 */
            --primary-color: #3b82f6; /* blue-500 */
            --text-gray-900: #111827;
            --text-gray-700: #374151;
            --font-family: Roboto, sans-serif;
        }

        /* Container (details) */
        .accordion-item {
            background-color: var(--bg-card);
            border-radius: 0.5rem; /* rounded-lg */
            border: 2px solid var(--border-color); /* border-2 border-border */
            overflow: hidden;
            transition: border-color 150ms ease; /* transition on hover */
            max-width: 600px; /* Optional: limit width for demo */
            /* font-family: var(--font-family); */
        }

            .accordion-item:hover {
                border-color: var(--primary-color); /* hover:border-primary */
            }

        /* Trigger (summary) */
        .accordion-trigger {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 2rem; /* p-8 */
            cursor: pointer;
            list-style: none; /* list-none */
            outline: none;
        }

            /* Hide default triangle marker (Chrome/Safari/Edge) */
            .accordion-trigger::-webkit-details-marker {
                display: none;
            }

        /* Title (h3) */
        .accordion-title {
            font-size: 1.5rem; /* text-2xl */
            line-height: 2rem;
            font-weight: 700; /* font-bold */
            color: var(--text-gray-900);
            margin: 0;
        }

        /* Icon (svg) */
        .accordion-icon {
            width: 1.5rem;
            height: 1.5rem;
            color: var(--primary-color);
            transition: transform 300ms ease;
        }

        /* Icon Rotation Logic */
        .accordion-item[open] .accordion-icon {
            transform: rotate(180deg);
        }

        /* Content Wrapper */
        .accordion-content {
            padding: 1rem 2rem 2rem 2rem; /* pt-4 px-8 pb-8 */
            border-top: 1px solid var(--border-color); /* border-t */
            font-size: 1rem; /* text-base */
        }

  
</style>

<div class="gifts-widget">
    @if (Model.DisplayWalletDetails && Model.GiftWalletAmount > 0)
    {
        var remainingBalance = Model.GiftWalletAmount - Model.GiftWalletSpent;
        var formattedRemainingBalance = remainingBalance.ToString("C");
        
        <div class="gift-wallet-amount" style="color: #666; font-size: 1.2em; margin-bottom: 15px; padding: 10px; background-color: #f5f5f5; border-radius: 4px;">
            <div style="margin-bottom: 5px;">
                <strong>@T("Plugins.Ecomzen.Gifts.GiftWallet"):</strong> @Model.FormattedGiftWalletAmount
            </div>
            @if (Model.GiftWalletSpent > 0)
            {
                <div style="font-size: 0.9em; color: #999;">
                    @T("Plugins.Ecomzen.Gifts.Spent"): @Model.FormattedGiftWalletSpent
                </div>
                <div style="font-size: 0.95em; color: #333; margin-top: 5px;">
                    <strong>@T("Plugins.Ecomzen.Gifts.Remaining"):</strong> @Model.FormattedGiftWalletRemaining
                </div>
            }
        </div>
    }



        <details class="accordion-item">
            <summary class="accordion-trigger">
                <h3 class="accordion-title">@Model.TitleDescription</h3>
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="accordion-icon"
                     aria-hidden="true">
                    <path d="m6 9 6 6 6-6"></path>
                </svg>
            </summary>

            <div class="accordion-content">
                @if (!string.IsNullOrEmpty(Model.GiftsDescription))
                {
                    <div class="gifts-description">
                        @Html.Raw(Model.GiftsDescription)
                    </div>
                }
            </div>
        </details>

    
    @if (Model.Products != null && Model.Products.Any())
    {
        var catalogModel = new Nop.Web.Models.Catalog.CatalogProductsModel
        {
            Products = Model.Products.ToList()
        };


        
        <div class="product-grid">
            @await Html.PartialAsync("~/Views/Catalog/_ProductsInGridOrLines.cshtml", catalogModel)
        </div>
    }
    else
    {
        <div class="no-data">
            @T("Plugins.Ecomzen.Gifts.NoProducts")
        </div>
    }
</div>


</text>